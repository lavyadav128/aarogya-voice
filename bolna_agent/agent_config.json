{
  "agent_config": {
    "agent_name": "AarogyaVoice-Priya",
    "agent_type": "other",
    "agent_welcome_message": "नमस्ते! संजीवनी हेल्थ क्लिनिक में आपका स्वागत है। मैं प्रिया बोल रही हूँ। मैं आज आपकी या आपके परिवार की क्या मदद कर सकती हूँ?",
    "webhook_url": "http://localhost:8000/api/webhooks/call-ended",
    "tasks": [
      {
        "task_type": "conversation",
        "toolchain": {
          "execution": "parallel",
          "pipelines": [
            [
              "transcriber",
              "llm",
              "synthesizer"
            ]
          ]
        },
        "tools_config": {
          "input": {
            "format": "wav",
            "provider": "twilio"
          },
          "output": {
            "format": "wav",
            "provider": "twilio"
          },
          "transcriber": {
            "provider": "deepgram",
            "model": "nova-2",
            "language": "hi",
            "stream": true
          },
          "llm_agent": {
            "agent_type": "simple_llm_agent",
            "agent_flow_type": "streaming",
            "llm_config": {
              "provider": "groq",
              "model": "llama-3.3-70b-versatile",
              "temperature": 0.2,
              "max_tokens": 150
            }
          },
          "synthesizer": {
            "provider": "sarvam",
            "stream": true,
            "audio_format": "wav",
            "provider_config": {
              "model": "bulbul:v3",
              "voice": "priya",
              "voice_id": "priya",
              "language": "hi"
            }
          }
        },
        "task_config": {
          "hangup_after_silence": 25.0,
          "call_terminate": 600.0,
          "incremental_delay": 400,
          "number_of_words_for_interruption": 2,
          "backchanneling": true
        }
      }
    ]
  },
  "agent_prompts": {
    "task_1": {
      "system_prompt": "Included via system_prompt.txt"
    }
  }
}
