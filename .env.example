# ==============================================================================
# AarogyaVoice Environment Configuration
# ==============================================================================

# 1. Bolna Voice AI Platform
# Sign up at https://www.bolna.ai - all participants get $10 free credits.
BOLNA_API_KEY=your_bolna_api_key_here
BOLNA_AGENT_ID=your_bolna_agent_id_here

# 2. LLM Engine (Provider for Reasoning & Function Calling)
# Fast sub-200ms TTFT recommended: OpenAI (gpt-4o-mini) or Groq (llama-3.3-70b-versatile)
OPENAI_API_KEY=your_openai_or_groq_api_key_here

# 3. Speech-to-Text (STT / ASR)
# Deepgram Nova-2 (https://deepgram.com) or Sarvam AI Saarika (https://sarvam.ai)
DEEPGRAM_API_KEY=your_deepgram_api_key_here
SARVAM_API_KEY=your_sarvam_api_key_here

# 4. Text-to-Speech (TTS / Synthesizer)
# Cartesia Sonic (https://cartesia.ai) or ElevenLabs Turbo v2.5 or Sarvam Bulbul
CARTESIA_API_KEY=your_cartesia_api_key_here
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# 5. Telephony Provider (Optional for PSTN dial-in)
# Plivo, Exotel, or Twilio SIP credentials
TELEPHONY_PROVIDER=twilio
TELEPHONY_ACCOUNT_SID=
TELEPHONY_AUTH_TOKEN=
TELEPHONY_PHONE_NUMBER=

# 6. AarogyaVoice Webhook Public URL
# When testing locally with Bolna, use ngrok or localtunnel (e.g., https://your-domain.ngrok-free.app)
BACKEND_PUBLIC_URL=http://localhost:8000

# 7. Clinic Settings
CLINIC_NAME="Sanjeevani Community Health Center"
CLINIC_LOCATION="Indiranagar, Bengaluru"
EMERGENCY_AMBULANCE_NUMBER="108"
